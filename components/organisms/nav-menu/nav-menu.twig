{# Keep native Url/Attribute objects and render each link through Drupal. #}
{% set alignment_classes = {
  right: 'justify-content-end', center: 'justify-content-center', vertical: 'flex-column'
} %}
{% set classes = ['nav', 'level-1', 'actools-navigation__list',
  alignment_classes[alignment|default('')]|default(''),
  style|default('') ? 'nav-' ~ style : '', fill|default('') ? 'nav-' ~ fill : ''
]|merge(nav_menu_utility_classes|default([])) %}
{% if items %}
  <ul{{ attributes.addClass(classes) }}>
    {% include '@actools_bs5/components/organisms/nav-menu/navigation-items.twig' with {
      items: items,
      enhance: actools_navigation_enhance|default(false),
      level: 1,
      prefix: actools_navigation_instance|default('navigation'|clean_unique_id),
    } only %}
  </ul>
{% endif %}

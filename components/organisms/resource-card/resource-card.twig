{# Drupal fields arrive through slots; the title and URL are plain scalar props. #}
{# Render before testing emptiness so denied/empty fields still bubble cache
   metadata. Print the captured markup unchanged; trim is only a predicate. #}
{% set metadata_markup %}{% block metadata %}{% endblock %}{% endset %}
<div{{ attributes.addClass('actools-resource-card') }}>
  <div class="actools-resource-card__media">{% block media %}{% endblock %}</div>
  <div class="actools-resource-card__content">
    {% if metadata_markup|trim %}
      <div class="actools-resource-card__metadata actools-resource-metadata">{{ metadata_markup }}</div>
    {% endif %}
    {% if heading %}
      {% include 'actools_bs5:heading' with {
        heading_text: heading,
        level: 3,
        url: url|default(''),
        attributes: (title_attributes|default(create_attribute())).addClass('actools-resource-card__heading'),
      } only %}
    {% endif %}
    <div class="actools-resource-card__summary">{% block body %}{% endblock %}</div>
  </div>
</div>

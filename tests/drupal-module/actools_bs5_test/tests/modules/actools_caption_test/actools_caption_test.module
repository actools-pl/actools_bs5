<?php

/**
 * @file
 * Deferred caption-access fixtures for the dedicated caption Kernel tests.
 */

use Drupal\actools_caption_test\Render\CaptionAccessProbe;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_ENTITY_TYPE_view_alter() for block_content.
 */
function actools_caption_test_block_content_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  $probe = \Drupal::state()->get('actools_caption_test.access_probe', []);
  if ((string) ($probe['block_id'] ?? '') === (string) $entity->id() && isset($build['field_actools_caption'])) {
    $caption = &$build['field_actools_caption'];
    unset($caption['#access']);
    $caption['#access_callback'] = [CaptionAccessProbe::class, 'access'];
    $caption['#actools_caption_access_mode'] = $probe['mode'];
    $caption['#cache']['tags'][] = 'actools_caption_element:probe';
    // Descendant settings must never render if the parent field is denied.
    $caption[0]['#attached']['drupalSettings']['actoolsCaptionProbe'] = 'Caption-only attachment';
  }
  $image_probe = \Drupal::state()->get('actools_caption_test.image_access_probe', []);
  if ((string) ($image_probe['block_id'] ?? '') === (string) $entity->id() && isset($build['field_actools_image'])) {
    $image = &$build['field_actools_image'];
    unset($image['#access']);
    $image['#access_callback'] = [CaptionAccessProbe::class, 'access'];
    $image['#actools_caption_access_mode'] = $image_probe['mode'];
    $image['#cache']['tags'][] = 'actools_image_element:caption_probe';
    $image[0]['#attached']['drupalSettings']['actoolsImageProbe'] = 'Image-only attachment';
  }
}

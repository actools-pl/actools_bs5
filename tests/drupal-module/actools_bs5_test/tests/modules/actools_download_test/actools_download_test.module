<?php

/**
 * @file
 * Deferred field, item and nested-link fixtures for download Kernel tests.
 */

use Drupal\actools_download_test\Render\DownloadAccessProbe;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_ENTITY_TYPE_view_alter() for node.
 */
function actools_download_test_node_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  $probe = \Drupal::state()->get('actools_download_test.access_probe', []);
  if ((string) ($probe['node_id'] ?? '') !== (string) $entity->id() || !isset($build['field_actools_download'])) {
    return;
  }
  $field = &$build['field_actools_download'];
  if ($probe['target'] === 'field') {
    $element = &$field;
  }
  elseif ($probe['target'] === 'item' && isset($field[0])) {
    $element = &$field[0];
  }
  else {
    return;
  }
  unset($element['#access']);
  if ($probe['mode'] === 'explicit_boolean_denied') {
    $element['#access'] = FALSE;
  }
  else {
    $element['#access_callback'] = [DownloadAccessProbe::class, 'access'];
    $element['#actools_download_access_mode'] = $probe['mode'];
  }
  $element['#cache']['tags'][] = 'actools_download_element:' . $probe['target'];
}

/**
 * Implements hook_preprocess_file_link().
 */
function actools_download_test_preprocess_file_link(array &$variables): void {
  $probe = \Drupal::state()->get('actools_download_test.access_probe', []);
  if (($probe['target'] ?? '') !== 'link'
    || (string) ($probe['file_id'] ?? '') !== (string) $variables['file']->id()) {
    return;
  }
  $link = &$variables['link'];
  unset($link['#access']);
  if ($probe['mode'] === 'explicit_boolean_denied') {
    $link['#access'] = FALSE;
  }
  else {
    $link['#access_callback'] = [DownloadAccessProbe::class, 'access'];
    $link['#actools_download_access_mode'] = $probe['mode'];
  }
  $link['#cache']['tags'][] = 'actools_download_element:link';
}

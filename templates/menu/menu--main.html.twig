{# The surrounding native menu block supplies the named navigation landmark. #}
{% set is_header = actools_navigation_header|default(false) %}
{% set instance = actools_navigation_instance|default('main-navigation'|clean_unique_id) %}
{% set panel_id = instance ~ '-panel' %}
{% if is_header %}{{ attach_library('actools_bs5/navigation') }}{% endif %}
<div class="actools-primary-navigation{{ is_header ? '' : ' actools-static-navigation' }}"
     data-actools-navigation data-actools-nav-region="{{ actools_navigation_region|default('content') }}">
  {% if is_header %}
    {# No-JS lists are visible. Buttons appear after successful enhancement. #}
    <button class="actools-navigation__toggle" type="button" hidden
            data-actools-nav-toggle aria-controls="{{ panel_id }}" aria-expanded="true">
      <span class="actools-navigation__toggle-icon" aria-hidden="true"></span>
      <span>{{ 'Menu'|t }}</span>
    </button>
    <div id="{{ panel_id }}" class="actools-navigation__panel" data-actools-nav-panel>
  {% endif %}
  {% include 'actools_bs5:nav-menu' with {
    actools_navigation_enhance: is_header,
    actools_navigation_instance: instance,
  } %}
  {% if is_header %}</div>{% endif %}
</div>
